# Orbit - Satellite Learning Environment Configuration
# Copy this file to .env and configure your credentials.
# Do not commit your real .env file.

# Choose the answer provider: openai or gemini.
AI_PROVIDER=gemini

# For OpenAI answers, translation, and optional semantic embeddings:
# Obtain a key from https://platform.openai.com/api-keys
#OPENAI_API_KEY=your-key-here

# For Gemini answers and translation:
# Obtain a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here

# Optional model configurations (defaults are shown below):
# CHAT_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=text-embedding-3-small
